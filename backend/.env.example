# Copy to .env and fill in. Never commit .env.

# "production" refuses to boot with placeholder JWT_SECRET/ADMIN_PASSWORD.
# Leave as development for local work.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./crm.db
JWT_SECRET=generate-a-long-random-string
ADMIN_EMAIL=hello@estimoto.io
ADMIN_PASSWORD=pick-a-strong-password

# Optional: enables Claude-powered email extraction (falls back to header
# parsing when unset).
ANTHROPIC_API_KEY=

# Comma-separated origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- Native Gmail integration (preferred) ---
# Reuses the Estimoto Google OAuth client (same env names as the product
# backend). Two one-time steps in Google Cloud console for that client:
#   1. Add the redirect URI below to "Authorized redirect URIs".
#   2. Ensure the Gmail API is enabled for the project.
# Then click "Connect Gmail" on the Inbox page and approve as
# hello@estimoto.io. Scope requested: gmail.modify (read + mark-as-read;
# no send, no delete).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/api/gmail/callback
FRONTEND_URL=http://localhost:5173

# --- IMAP auto-ingestion (fallback, app-password based) ---
# Only needed if not using the Gmail integration above. JSON list of
# mailboxes to poll; for Google Workspace accounts this requires an App
# Password (https://myaccount.google.com/apppasswords).
# IMAP_ACCOUNTS=[{"email": "hello@estimoto.io", "password": "app-password-here"}]
IMAP_ACCOUNTS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_POLL_SECONDS=120
