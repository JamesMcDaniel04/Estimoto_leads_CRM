# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite+aiosqlite:///./crm.db
JWT_SECRET=generate-a-long-random-string
ADMIN_EMAIL=hello@estimoto.io
ADMIN_PASSWORD=pick-a-strong-password

# Optional: enables Claude-powered email extraction (falls back to header
# parsing when unset).
ANTHROPIC_API_KEY=

# Comma-separated origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- IMAP auto-ingestion (optional) ---
# JSON list of mailboxes to poll for unseen mail. For Google Workspace
# (estimoto.io): enable IMAP for the account, turn on 2-step verification,
# and create an App Password at https://myaccount.google.com/apppasswords —
# the regular account password will NOT work.
# IMAP_ACCOUNTS=[{"email": "hello@estimoto.io", "password": "app-password-here"}, {"email": "estimates@estimoto.io", "password": "app-password-here"}]
IMAP_ACCOUNTS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_POLL_SECONDS=120
